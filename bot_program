def track_metrics(handler_name):
    def decorator(func):
        @wraps(func)
        async def wrapper(update: Update, context: CallbackContext):
            user = update.effective_user
            USER_ACTIVITY.labels(user_id=user.id, command=handler_name).inc() # Увеличиваем счетчик активных пользователей

            try:
                result = await func(update, context)
                status = "success"
                return result
            except Exception as e:
                status = "error"
                raise
            finally:
                # Фиксируем время выполнения
                duration = time.time() - start_time
                REQUEST_TIME.labels(handler=handler_name).observe(duration)
                REQUEST_COUNT.labels(handler=handler_name, status=status).inc()
                ACTIVE_USERS.dec()  # Уменьшаем счетчик

        return wrapper

    return decorator

